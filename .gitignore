cat > .gitignore <<'EOF'
# Python
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage

# Environment/secrets
.env
.env.*
!.env.example

# SQLite/runtime database
*.db
*.sqlite
*.sqlite3

# Uploaded/generated audio
uploads/
audio/
*.wav
*.mp3
*.m4a
*.ogg
*.webm

# macOS
.DS_Store

# Node/n8n
node_modules/
.n8n/
npm-debug.log*
EOF